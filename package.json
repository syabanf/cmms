{
  "name": "cmms",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:admin": "pnpm --filter @cmms/admin dev",
    "dev:mobile": "pnpm --filter @cmms/mobile dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p scripts",
    "format": "prettier --write .",
    "gen:fixtures": "tsx scripts/generate-fixtures.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.2",
    "typescript": "~5.9.3"
  }
}
